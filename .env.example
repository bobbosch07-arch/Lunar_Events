# ============================================================
# Vorlage. Kopieren nach .env.local (steht nicht im Git).
#
# Wichtig fürs Hosting: Variablen mit NEXT_PUBLIC_ werden beim BAUEN
# eingesetzt, nicht beim Ausführen. Wer sie in Vercel nachträgt, muss
# danach neu ausliefern — sonst ändert sich nichts.
#
# Ob eine laufende Auslieferung sie hat, sagt /api/status.
# ============================================================

# ---------- Supabase ----------
# Projekt unter supabase.com anlegen, Region Frankfurt.
NEXT_PUBLIC_SUPABASE_URL=

# Der öffentliche Schlüssel. Supabase nennt ihn inzwischen "publishable
# key" (sb_publishable_…), früher hieß er "anon key" (ein JWT). Beide
# Namen werden akzeptiert — nimm den, der im Dashboard steht.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Umgeht ALLE Zugriffsregeln. Nur serverseitig, niemals ins Frontend.
# Heißt im Dashboard "service_role" oder "secret" (sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Aus dem Webhook-Eintrag im Stripe-Dashboard; lokal liefert ihn
# "stripe listen --forward-to localhost:3000/api/stripe/webhook".
STRIPE_WEBHOOK_SECRET=

# ---------- PayPal ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Aus dem Webhook-Eintrag im PayPal-Dashboard. Ohne ihn werden
# eingehende Meldungen verworfen — sie liessen sich sonst faelschen.
PAYPAL_WEBHOOK_ID=
# PayPal verraet nicht am Schluessel, ob es echtes Geld ist. Deshalb
# ausdruecklich: "live" oder leer lassen fuer die Sandbox.
PAYPAL_UMGEBUNG=

# ---------- Mailversand ----------
# Ohne diesen Schlüssel sagt die Bestätigungsseite ausdrücklich, dass
# keine Tickets verschickt werden. Das ist Absicht.
RESEND_API_KEY=

# ---------- Wallet-Pässe (später) ----------
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_ZERTIFIKAT_P12_BASE64=
APPLE_WALLET_ZERTIFIKAT_PASSWORT=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# ---------- Adresse der Seite ----------
# Für Rückleitungen der Zahlungsanbieter und die Sitemap.
# Auf Vercel sonst automatisch aus VERCEL_URL abgeleitet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
